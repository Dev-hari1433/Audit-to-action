# AccessTrack — Environment Configuration
# Copy this file to .env.local to configure custom services.

# Google Gemini API (Free tier from https://aistudio.google.com/)
# Used for real multimodal vision photo screening and multilingual voice intent extraction.
# If not provided, AccessTrack operates in robust High-Fidelity Demo AI mode with zero errors.
GEMINI_API_KEY=

# Supabase Configuration (Optional for cloud database & storage)
# When omitted, AccessTrack uses its interconnected local database store (localStorage & in-memory).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Site URL for metadata and OpenGraph
NEXT_PUBLIC_SITE_URL=http://localhost:3000
