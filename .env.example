# Supabase — leave blank to use the seeded local demo mode
NEXT_PUBLIC_SUPABASE_URL=
# Recommended modern browser-safe key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy fallback for existing projects
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional AI photo analysis. Never expose this value to the browser.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Trusted public origin used for absolute social metadata
NEXT_PUBLIC_SITE_URL=http://localhost:3000
